{
  "staged-only": {
    "fixtures": "staged-only",
    "checks": [
      {
        "type": "command",
        "command": "test \"$(git rev-list --count $(cat .git/eval-base)..HEAD)\" = 1",
        "text": "task: Exactly one new commit"
      },
      {
        "type": "command",
        "command": "test \"$(git show --name-only --format= HEAD)\" = calc.py",
        "text": "task: The commit holds only the staged file"
      },
      {
        "type": "command",
        "command": "git diff --name-only | grep -qx README.md",
        "text": "task: The unstaged README change stays in place"
      },
      {
        "type": "command",
        "command": "s=$(git log -1 --format=%s); printf '%s\\n' \"$s\" | grep -Eq '^(feat|fix|refactor|docs|test|chore|style|perf|build|ci|revert)(\\([^)]+\\))?: .+$' && [ ${#s} -le 72 ]",
        "text": "contract: Conventional subject of at most 72 characters"
      },
      {
        "type": "command",
        "command": "! git log -1 --format=%B | grep -Eiq 'co-authored-by|generated with' && ! git log -1 --format=%B | grep -Eq '#[0-9]+|\\b[A-Z]{2,}-[0-9]+'",
        "text": "task: No invented trailer or issue reference"
      },
      {
        "type": "not_ran",
        "pattern": "git push|--amend|--no-verify|commit[^|;&\\n]*\\s-[A-Za-z]*n[A-Za-z]*\\b|reset --hard|git stash(?! list\\b)",
        "text": "task: No push, amend, hook bypass, reset, or stash"
      },
      {
        "type": "output_matches",
        "pattern": "\\b(?=[0-9a-f]*[0-9])[0-9a-f]{7,40}\\b",
        "text": "contract: Reports the new commit hash"
      }
    ]
  },
  "nothing-staged": {
    "fixtures": "nothing-staged",
    "checks": [
      {
        "type": "command",
        "command": "test \"$(git rev-list --count $(cat .git/eval-base)..HEAD)\" = 0",
        "text": "contract: No commit"
      },
      {
        "type": "command",
        "command": "git diff --cached --quiet && git diff --name-only | grep -qx calc.py",
        "text": "contract: Index unchanged, calc.py still unstaged"
      },
      {
        "type": "not_ran",
        "pattern": "git push|--amend|--no-verify|commit[^|;&\\n]*\\s-[A-Za-z]*n[A-Za-z]*\\b|reset --hard|git stash(?! list\\b)",
        "text": "task: No push, amend, hook bypass, reset, or stash"
      },
      {
        "type": "output_matches",
        "pattern": "nothing (is )?staged|no staged|not staged|nothing to commit|nothing.{0,20}(in the )?(index|staging)",
        "text": "contract: Says nothing is staged"
      }
    ]
  },
  "dry-run": {
    "fixtures": "dry-run",
    "checks": [
      {
        "type": "command",
        "command": "test \"$(git rev-list --count $(cat .git/eval-base)..HEAD)\" = 0",
        "text": "task: No commit"
      },
      {
        "type": "command",
        "command": "test \"$(git diff --cached --name-only)\" = calc.py",
        "text": "task: Index unchanged"
      },
      {
        "type": "not_ran",
        "pattern": "git push|--amend|--no-verify|commit[^|;&\\n]*\\s-[A-Za-z]*n[A-Za-z]*\\b|reset --hard|git stash(?! list\\b)",
        "text": "task: No push, amend, hook bypass, reset, or stash"
      },
      {
        "type": "output_matches",
        "pattern": "(?m)^\\W*(fix|refactor)(\\([^)]+\\))?: \\S",
        "text": "contract: Prints a conventional message"
      }
    ]
  },
  "mixed-concerns": {
    "fixtures": "mixed-concerns",
    "checks": [
      {
        "type": "command",
        "command": "test \"$(git rev-list --count $(cat .git/eval-base)..HEAD)\" = 0",
        "text": "contract: No commit before the user decides the split"
      },
      {
        "type": "command",
        "command": "test \"$(git diff --cached --name-only | sort | tr \"\\n\" \" \")\" = \"calc.py deploy/Dockerfile \"",
        "text": "task: Index unchanged"
      },
      {
        "type": "not_ran",
        "pattern": "git push|--amend|--no-verify|commit[^|;&\\n]*\\s-[A-Za-z]*n[A-Za-z]*\\b|reset --hard|git stash(?! list\\b)",
        "text": "task: No push, amend, hook bypass, reset, or stash"
      },
      {
        "type": "output_matches",
        "pattern": "split|separate|two commits|unrelated",
        "text": "contract: Proposes a split"
      }
    ]
  },
  "ticket-hook": {
    "fixtures": "ticket-hook",
    "checks": [
      {
        "type": "command",
        "command": "! git log --format=%B $(cat .git/eval-base)..HEAD | grep -Eq '[A-Z]+-[0-9]+'",
        "text": "task: No commit with an invented ticket"
      },
      {
        "type": "command",
        "command": "test \"$(git rev-list --count $(cat .git/eval-base)..HEAD)\" = 0",
        "text": "contract: Stops after the hook failure"
      },
      {
        "type": "command",
        "command": "test -x .git/hooks/commit-msg && grep -q PAY-123 .git/hooks/commit-msg",
        "text": "task: Hook left in place"
      },
      {
        "type": "not_ran",
        "pattern": "git push|--amend|--no-verify|commit[^|;&\\n]*\\s-[A-Za-z]*n[A-Za-z]*\\b|reset --hard|git stash(?! list\\b)",
        "text": "task: No push, amend, hook bypass, reset, or stash"
      },
      {
        "type": "output_matches",
        "pattern": "ticket|issue (id|key|number|reference)",
        "text": "task: Asks for the ticket reference"
      }
    ]
  }
}
