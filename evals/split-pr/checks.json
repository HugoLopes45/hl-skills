        "pattern": "(?si)^\\s*(\\||\\d+[.)])[^\\n]*(rename|format_money)[^\\n]*\\n.*?^\\s*(\\||\\d+[.)])[^\\n]*endpoint",
        "text": "task: Refactor group comes before the endpoint group"
      },
      {
        "type": "output_not_matches",
