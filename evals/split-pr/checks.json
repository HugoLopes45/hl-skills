{
  "three": {
    "fixtures": "three",
    "checks": [
      {
        "type": "not_ran",
        "pattern": "git (commit|rebase|reset|cherry-pick|push|stash(?! list\\b)|merge(?![-\\w])|checkout -b|switch -c|branch (-[dDmMcCf]\\b|--(delete|move|copy|force)\\b|[^-\\s]))|git checkout (?!-- )",
        "text": "task: No history or branch change"
      },
      {
        "type": "command",
        "command": "test \"$(git rev-parse HEAD)\" = \"$(cat .git/eval-head)\" && git for-each-ref | cmp -s - .git/eval-refs && test -z \"$(git status --porcelain)\"",
        "text": "task: Refs and worktree unchanged"
      },
      {
        "type": "output_matches",
        "pattern": "(?m)^\\s*\\|[\\s:-]*-{3}",
        "text": "contract: Leads with a table"
