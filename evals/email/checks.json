{
  "email-draft-no-invented-offer": {
    "fixtures": "email-brief",
    "checks": [
      {
        "type": "workspace_untouched",
        "text": "task: No file added, removed, or modified"
      },
      {
        "type": "command",
        "command": "python3 \"$EVALS/oracle.py\" block-lacks '20\\s?%|Friday'",
        "text": "task: The invented discount and deadline are not written as copy"
      },
      {
        "type": "command",
        "command": "python3 \"$EVALS/oracle.py\" block-has 'PLACEHOLDER'",
        "text": "task: Missing offer or deadline is a placeholder in the copy"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)(discount|offer)[^\\n]*(not supplied|none supplied|not provided|placeholder|missing)",
        "text": "task: Names the discount as not supplied"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)deadline[^\\n]*(not supplied|none supplied|not provided|placeholder|missing)",
        "text": "task: Names the deadline as not supplied"
      }
    ]
  },
  "email-revise-keeps-facts": {
    "fixtures": "email-revise",
    "checks": [
      {
        "type": "workspace_untouched",
        "text": "task: No file added, removed, or modified"
      },
      {
        "type": "command",
        "command": "python3 \"$EVALS/oracle.py\" block-has '3 June'",
        "text": "task: The supplied export date is kept in the revised email"
      },
      {
        "type": "command",
        "command": "python3 \"$EVALS/oracle.py\" block-has '\\$19'",
        "text": "task: The supplied price is kept in the revised email"
      },
      {
        "type": "command",
        "command": "python3 \"$EVALS/oracle.py\" block-lacks '12,000|14 June'",
        "text": "task: The unsupported shop count and closing date are removed from the revised email"
      },
      {
        "type": "output_matches",
        "pattern": "(?m)^\\W*Verdict:\\s*Revised",
        "text": "contract: Verdict Revised"
      }
    ]
  }
}
