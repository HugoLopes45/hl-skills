{
  "internal-linking-orphan-json": {
    "fixtures": "links-export",
    "checks": [
      {
        "type": "command",
        "command": "python3 -c \"import json,sys; json.loads(sys.stdin.read())\"",
        "text": "contract: The whole answer is one JSON value"
      },
      {
        "type": "output_matches",
        "pattern": "\"orphan_urls\"\\s*:\\s*\\[\\s*\"/guides/invoice-reminders\"\\s*\\]",
        "text": "task: Finds exactly the orphan page"
      },
      {
        "type": "output_matches",
        "pattern": "\"broken_link_targets\"\\s*:\\s*\\[\\s*\"/guides/old-reminder-templates\"\\s*\\]",
        "text": "task: Finds exactly the broken link target"
      },
      {
        "type": "output_not_matches",
        "pattern": "```|Verdict:",
        "text": "contract: No code fence and no default verdict wrapper"
      }
    ]
  },
  "internal-linking-no-export": {
    "fixtures": "none",
    "checks": [
      {
        "type": "workspace_untouched",
        "text": "task: No file added, removed, or modified"
      },
      {
        "type": "command",
        "command": "python3 \"$EVALS/oracle.py\" questions-next",
        "text": "task: Asks focused questions"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)export|crawl",
        "text": "task: Asks for the link export or crawl"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)default",
        "text": "contract: Each question gives its default"
      },
      {
        "type": "output_matches",
        "pattern": "(?m)^\\W*Verdict:\\W*Stopped",
        "text": "contract: Verdict Stopped without an export"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?m)^\\W*Verdict:\\W*(Sound|Fix first|Fix later)",
        "text": "task: No link verdict without evidence"
      }
    ]
  }
