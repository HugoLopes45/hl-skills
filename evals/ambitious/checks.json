        "type": "output_matches",
        "pattern": "(?i)(stretch|proposed|optional)[^\\n]{0,120}\\b\\d+(\\.\\d+)? ?(ms|s|sec|seconds)\\b|\\b\\d+(\\.\\d+)? ?(ms|s|sec|seconds)\\b[^\\n]{0,120}\\b(stretch|proposed|optional)",
        "text": "contract: Offers a more ambitious target, marked proposed or optional"
      }
    ]
  }
}
