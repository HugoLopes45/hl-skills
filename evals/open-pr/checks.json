        "pattern": "(?m)^[^\\n]*(\\bmain\\b)[^\\n]*(same|base|already|current branch|itself)|^[^\\n]*(same|base|already|current branch|itself)[^\\n]*(\\bmain\\b)|\\byou('re| are) on `?main\\b",
        "text": "contract: Says the current branch is the base"
      },
      {
        "type": "output_matches",
        "pattern": "^\\W*Verdict:\\W*(stopped)",
