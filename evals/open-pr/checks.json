{
  "pr-dry-run": {
    "fixtures": "pr-dry-run",
    "checks": [
      {
        "type": "not_ran",
        "pattern": "git (push|commit|add|stash(?! list\\b)|reset)\\b|--force|gh pr create(?![^|;&\\n]*--help)",
        "text": "task: No push, PR creation, commit, or staging"
      },
      {
        "type": "command",
        "command": "test \"$(git rev-parse HEAD)\" = \"$(cat .git/eval-head)\" && git diff --cached --quiet && git diff --name-only | grep -qx README.md",
        "text": "task: Branch and index unchanged; README still uncommitted"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)verification",
        "text": "contract: Body has a verification section"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)risk|rollback",
        "text": "contract: Body has risks"
      },
      {
        "type": "output_matches",
        "pattern": "(?m)^[^\\n]*(README)[^\\n]*(uncommitted|not (part|included|committed)|unstaged|working tree)|^[^\\n]*(uncommitted|not (part|included|committed)|unstaged|working tree)[^\\n]*(README)",
        "text": "contract: Reports the uncommitted README change"
      },
      {
        "type": "output_matches",
        "pattern": "^\\W*Verdict:\\W*(preview)",
        "text": "contract: Verdict line says Preview"
      },
      {
        "type": "first_line",
        "pattern": "^(?!\\W*(verdict|status|opened|preview|already open|stopped)\\b)",
        "text": "contract: Line 1 opens with no label"
      },
      {
        "type": "output_matches",
        "pattern": "\\A\\s*\\*\\*[^\\n]+\\*\\*[ \\t]*\\n",
        "text": "contract: Line 1 is one bold sentence"
      },
      {
        "type": "output_matches",
        "pattern": "(?m)^\\W*Verdict:[^\\n]*\\n\\s*\\**Next:",
        "text": "contract: Verdict line sits just before Next"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?im)^\\W*(left out|blocker|coupling|scope|build and tests|not in this pull request|not saved|destination|proof|reason|branch)\\s*:",
        "text": "contract: No label lines such as Left out or Scope"
      },
      {
        "type": "output_not_matches",
        "pattern": "\\b(S[0-3]|P[0-3]|AC-\\d+|SL-\\d+|Q\\d)\\b|\\[[A-Z]{2,}\\]",
        "text": "contract: No rank, internal ID, or bracket tag"
      },
      {
        "type": "output_matches",
        "pattern": "\\*\\*Changed:\\*\\*",
        "text": "contract: Changed line present, after Next"
      }
    ]
  },
  "no-gh": {
    "fixtures": "no-gh",
    "checks": [
      {
        "type": "command",
        "command": "test \"$(git rev-parse HEAD)\" = \"$(cat .git/eval-head)\" && git diff --cached --quiet && git diff --name-only | grep -qx README.md",
        "text": "task: Branch and index unchanged; README still uncommitted"
      },
      {
        "type": "not_ran",
        "pattern": "--force|--no-verify|git (commit|add|stash)\\b",
        "text": "task: No force, bypass, commit, or staging"
      },
      {
        "type": "output_not_matches",
        "pattern": "github\\.com/[^\\s]+/pull/\\d+",
        "text": "task: No invented PR URL"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)\\bgh\\b|github cli|remote|not available|unavailable|could ?n.t|cannot|can.t",
        "text": "contract: Reports the blocker"
      },
      {
        "type": "output_matches",
        "pattern": "^\\W*Verdict:\\W*(stopped)",
        "text": "contract: Verdict line says Stopped"
      },
      {
        "type": "first_line",
        "pattern": "^(?!\\W*(verdict|status|opened|preview|already open|stopped)\\b)",
        "text": "contract: Line 1 opens with no label"
      },
      {
        "type": "output_matches",
        "pattern": "\\A\\s*\\*\\*[^\\n]+\\*\\*[ \\t]*\\n",
        "text": "contract: Line 1 is one bold sentence"
      },
      {
        "type": "output_matches",
        "pattern": "(?m)^\\W*Verdict:[^\\n]*\\n\\s*\\**Next:",
        "text": "contract: Verdict line sits just before Next"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?im)^\\W*(left out|blocker|coupling|scope|build and tests|not in this pull request|not saved|destination|proof|reason|branch)\\s*:",
        "text": "contract: No label lines such as Left out or Scope"
      },
      {
        "type": "output_not_matches",
        "pattern": "\\b(S[0-3]|P[0-3]|AC-\\d+|SL-\\d+|Q\\d)\\b|\\[[A-Z]{2,}\\]",
        "text": "contract: No rank, internal ID, or bracket tag"
      },
      {
        "type": "output_matches",
        "pattern": "\\*\\*Changed:\\*\\*",
        "text": "contract: Changed line present, after Next"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?ms)^[ \\t]*\\d+[.)][ \\t][^\\n]*\\n(?:(?!^\\W*Verdict:).)*^\\W*Verdict:",
        "text": "contract: Ways to unblock appear once, in Next"
      }
    ]
  },
  "on-base": {
    "fixtures": "on-base",
    "checks": [
      {
        "type": "not_ran",
        "pattern": "git (push|commit|add|stash(?! list\\b)|reset)\\b|--force|gh pr create(?![^|;&\\n]*--help)",
