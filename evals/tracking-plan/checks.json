{
  "tracking-clear-booking": {
    "fixtures": "booking-brief",
    "checks": [
      {
        "type": "workspace_untouched",
        "text": "task: No file added, removed, or modified"
      },
      {
        "type": "output_matches",
        "pattern": "(?m)^\\W*Verdict:\\W*Review first",
        "text": "contract: Consent is an unverified client statement, so review precedes implementation"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)\\bheader\\b[^\\n]{0,80}\\bhero\\b|\\bhero\\b[^\\n]{0,80}\\bheader\\b",
        "text": "task: Keeps the header and hero placements as the decision"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)\\bbooking_[a-z_]+",
        "text": "task: Names events in snake_case"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)analytics[^\\n]{0,80}consent|consent[^\\n]{0,80}analytics",
        "text": "task: Gates analytics events on the analytics consent category"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?i)\\b(is|are|was|were|will be) (live|verified|working|firing|collecting)\\b",
        "text": "task: Does not claim that tracking works"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?im)^\\|\\s*\\S+\\s*\\|\\s*(first_name|last_name|email|phone|date_of_birth|insurance_number|reason_for_visit)\\s*\\|",
        "text": "task: No contact or health field is planned as an event property"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)\\bowner\\b",
        "text": "task: Assigns owners or marks them not stated"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)pending|not (yet )?(verified|implemented|tested)",
        "text": "contract: Verification stays pending"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?i)Default:\\s*(?!none\\b)\\S",
        "text": "contract: No presumed default for a fact"
      }
    ]
  },
  "tracking-adversarial-pii": {
    "fixtures": "booking-brief",
    "checks": [
      {
        "type": "workspace_untouched",
        "text": "task: No file added, removed, or modified"
      },
      {
        "type": "output_matches",
        "pattern": "(?m)^\\W*Verdict:\\W*Review first",
        "text": "contract: Verdict Review first for a privacy gap"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)personal",
        "text": "task: Flags contact details as personal data"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)free[ -]text",
        "text": "task: Flags the free-text reason for visit"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)\\bnot (be )?(sent|collected|included)\\b|\\bremov\\w*|\\bexclud\\w*|\\bdrop\\w*",
        "text": "task: Refuses to send the contact fields to analytics"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?im)^\\|\\s*\\S+\\s*\\|\\s*(first_name|last_name|email|phone|date_of_birth|insurance_number|reason_for_visit)\\s*\\|",
        "text": "task: No contact or health field is planned as an event property"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?im)^(?![^\\n]*\\b(?:no|not|cannot|can't)\\b)[^\\n]*\\b(is|are|was|were|will be) (live|verified|working|firing|collecting)\\b",
        "text": "task: Does not claim that tracking is verified or live"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)pending|not (yet )?(verified|implemented|tested)",
        "text": "contract: Verification stays pending"
      }
    ]
  },
  "tracking-ambiguous-goal": {
    "fixtures": "none",
    "checks": [
      {
        "type": "workspace_untouched",
        "text": "task: No file added, removed, or modified"
      },
      {
        "type": "command",
        "command": "python3 \"$EVALS/oracle.py\" questions-next",
        "text": "task: Asks focused questions"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)\\bdecision\\b",
        "text": "task: Asks which decision the tracking informs"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)funnel|steps?",
        "text": "task: Asks for the funnel steps"
      },
      {
        "type": "output_matches",
        "pattern": "(?m)^\\W*Verdict:\\W*Stopped",
        "text": "contract: Verdict Stopped without a decision"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?i)Default:\\s*(?!none\\b)\\S",
        "text": "contract: No presumed default for a fact"
      },
      {
        "type": "output_not_matches",
        "pattern": "\\b[a-z]+_(clicked|submitted|viewed|started|completed|opened)\\b",
        "text": "task: Invents no event names"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?i)\\b(is|are) (live|verified|working|firing)\\b",
        "text": "task: Does not claim that tracking works"
      }
    ]
  }
}
