{
  "douyin-clear-script": {
    "fixtures": "douyin-brief",
    "checks": [
      {
        "type": "workspace_untouched",
        "text": "task: No file added, removed, or modified"
      },
      {
        "type": "output_matches",
        "pattern": "[\\u4e00-\\u9fff]",
        "text": "contract: The script copy is in Chinese"
      },
      {
        "type": "output_matches",
        "pattern": "口播",
        "text": "contract: Has a spoken-lines section"
      },
      {
        "type": "output_matches",
        "pattern": "分镜",
        "text": "contract: Has a shot section"
      },
      {
        "type": "output_matches",
        "pattern": "(?m)^\\W*Verdict:\\W*Draft",
        "text": "contract: Verdict line Draft"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?i)第一|最好|一周|治疗|\\d+\\s*%",
        "text": "task: No rank, result, treatment, or percentage claim"
      }
    ]
  },
  "douyin-thin-brief": {
    "fixtures": "douyin-thin",
    "checks": [
      {
        "type": "workspace_untouched",
        "text": "task: No file added, removed, or modified"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)Default:\\s*none",
        "text": "contract: Facts are asked with Default: none"
      },
      {
        "type": "command",
        "command": "python3 \"$EVALS/oracle.py\" questions-next",
        "text": "contract: Stopped output has a Next question section"
      },
      {
        "type": "output_matches",
        "pattern": "(?m)^\\W*Verdict:\\W*Stopped",
        "text": "contract: Verdict line Stopped"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)受众|人群|audience|buyer|产品|product",
        "text": "task: Asks who the audience is or what the product is"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?m)^\\W*Verdict:\\W*Draft",
        "text": "contract: No draft verdict while facts are missing"
      }
    ]
  },
  "video-channel-youtube": {
    "fixtures": "portable-brief",
    "checks": [
      {
        "type": "workspace_untouched",
        "text": "task: No file added, removed, or modified"
      },
      {
        "type": "output_not_matches",
        "pattern": "[\\u4e00-\\u9fff]",
        "text": "task: Does not impose Chinese output on the requested English or French artifact"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)(?:USD\\s*12|12\\s*USD)",
        "text": "task: Preserves the explicitly supplied currency and price"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)Fold",
        "text": "task: Delivers copy about the supplied subject, not merely a refusal"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?i)(?:CNY|RMB|KES|CAD|EUR)\\s*\\d|[¥￥€]",
        "text": "task: Does not substitute a local currency"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)shot|scene|visual",
        "text": "task: Includes filming directions, not only a caption"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)music|audio|sound",
        "text": "task: Addresses sound rights without inventing a license"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)unverified|not verified|not supplied|unknown|check|confirm",
        "text": "task: Keeps missing platform or rights evidence visible"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)spoken|voice.?over|narration|dialogue",
        "text": "task: Includes spoken copy, not only filming directions"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)on.screen|overlay|subtitle",
        "text": "task: Includes on-screen text"
      },
      {
        "type": "output_matches",
        "pattern": "(?m)(?<!#)#[A-Za-z][\\w]+",
        "text": "task: Includes proposed topic tags"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)sponsor|paid partnership|disclosure",
        "text": "task: Addresses sponsorship or disclosure status"
      },
      {
        "type": "output_matches",
        "pattern": "\\b30\\b",
        "text": "task: Preserves the user's 30-second duration"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?m)^\\W*Verdict:\\W*Stopped",
        "text": "task: Does not refuse an adequately supplied cross-platform script"
      }
    ]
  },
