{
  "ab-test-blocked-baseline": {
    "fixtures": "ab-brief-missing",
    "checks": [
      {
        "type": "workspace_untouched",
        "text": "task: No file added, removed, or modified"
      },
      {
        "type": "output_matches",
        "pattern": "(?m)^\\W*Verdict:\\s*Sizing blocked",
        "text": "contract: Verdict Sizing blocked"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?i)sample size (is|of|per variant:?)\\s*\\d|\\b\\d{1,3}(,\\d{3})+\\s*(visitors|users|per)",
        "text": "task: No sample size is computed without a baseline"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)baseline",
        "text": "task: Names the missing baseline"
      }
    ]
  },
  "ab-test-stop-at-significance": {
    "fixtures": "ab-brief-full",
    "checks": [
      {
        "type": "workspace_untouched",
        "text": "task: No file added, removed, or modified"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?i)stop (the test )?(as soon as|once|when) (it )?(is |reaches |hits )?(significant|p ?< ?0?\\.05)|p ?< ?0?\\.05[^\\n]{0,40}(stop|ship|launch|roll ?out)",
        "text": "task: Does not adopt stopping at the first significant result"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)fixed.horizon|group.sequential|alpha.spending|O'?Brien|Pocock|always.valid|mSPRT",
        "text": "task: Names a fixed horizon or a named valid sequential method"
      },
      {
        "type": "output_matches",
        "pattern": "9,?147",
        "text": "task: Fixed-horizon size per variant is computed from the brief inputs"
      },
      {
        "type": "output_matches",
        "pattern": "(?i)recomput|recalculat|not reuse|do not reuse|cannot reuse|no reuse",
        "text": "task: Refuses to reuse the earlier fixed-run size for a sequential design"
      },
      {
        "type": "output_not_matches",
        "pattern": "(?i)(reuse|use|keep|same)[^\\n]{0,40}9,?147[^\\n]{0,60}sequential|sequential[^\\n]{0,80}9,?147",
        "text": "task: Does not pair the 9,147 fixed-horizon size with a sequential design"
      },
      {
        "type": "output_matches",
        "pattern": "(?m)^\\W*Verdict:\\s*(Planned|Sizing blocked|Stopped)",
        "text": "contract: Verdict Planned or Stopped"
      }
    ]
  }
}
